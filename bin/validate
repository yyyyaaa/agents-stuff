#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_DIR="$REPO_ROOT/.agents/skills"

shopt -s nullglob
fail=0
checked=0

for skill_dir in "$SOURCE_DIR"/*/; do
  skill_dir="${skill_dir%/}"
  skill_name="$(basename "$skill_dir")"
  skill_md="$skill_dir/SKILL.md"
  echo "==> $skill_name"
  checked=$((checked+1))

  if [[ ! -f "$skill_md" ]]; then
    echo "    FAIL: SKILL.md missing"
    fail=1
    continue
  fi

  frontmatter="$(awk 'BEGIN{c=0} /^---$/{c++; if(c==1)next; if(c==2)exit} c==1{print}' "$skill_md")"
  if [[ -z "$frontmatter" ]]; then
    echo "    FAIL: no frontmatter found"
    fail=1
    continue
  fi

  name_field="$(printf '%s\n' "$frontmatter" | awk '/^name:/{sub(/^name:[[:space:]]*/,""); print; exit}')"
  desc_field="$(printf '%s\n' "$frontmatter" | awk '/^description:/{sub(/^description:[[:space:]]*/,""); print; exit}')"

  ok=1
  if [[ -z "$name_field" ]]; then
    echo "    FAIL: name missing"
    ok=0
  elif [[ "$name_field" != "$skill_name" ]]; then
    echo "    FAIL: name '$name_field' != directory '$skill_name'"
    ok=0
  elif [[ ! "$name_field" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
    echo "    FAIL: name '$name_field' violates rules (lowercase, hyphens, no leading/trailing/consecutive hyphens)"
    ok=0
  elif [[ ${#name_field} -gt 64 ]]; then
    echo "    FAIL: name exceeds 64 chars"
    ok=0
  fi

  if [[ -z "$desc_field" ]]; then
    echo "    FAIL: description missing"
    ok=0
  elif [[ ${#desc_field} -gt 1024 ]]; then
    echo "    FAIL: description exceeds 1024 chars (${#desc_field})"
    ok=0
  fi

  if [[ $ok -eq 1 ]]; then
    echo "    ok (basic checks)"
  else
    fail=1
  fi
done

if [[ $checked -eq 0 ]]; then
  echo "no skills found in $SOURCE_DIR"
  exit 0
fi

if command -v skills-ref >/dev/null 2>&1; then
  echo
  echo "==> skills-ref"
  for skill_dir in "$SOURCE_DIR"/*/; do
    skill_dir="${skill_dir%/}"
    if ! skills-ref validate "$skill_dir"; then
      fail=1
    fi
  done
else
  echo
  echo "hint: install skills-ref for full spec validation"
  echo "      https://github.com/agentskills/agentskills"
fi

exit "$fail"
